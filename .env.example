# Database (Turso in production; defaults to file:local.db locally)
DATABASE_URL=libsql://your-database.turso.io
DATABASE_AUTH_TOKEN=

# Admin
# Required in production (login is disabled otherwise)
ADMIN_PASSWORD=
# Required in production: random string, 16+ chars (e.g. `openssl rand -hex 32`)
AUTH_SECRET=

# Cloudflare R2 storage (local public/uploads is used when R2_BUCKET_NAME / R2_ACCOUNT_ID are unset)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=your-bucket
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Public site origin for canonical URLs / OpenGraph / sitemap (defaults to the Vercel URL)
NEXT_PUBLIC_SITE_URL=
